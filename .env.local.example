# Required — the AI loops are real and will not run without this.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# claude-sonnet-5 is a cheaper drop-in; the eval harness reports the difference.
CLEARLINE_MODEL=claude-opus-5

# Local dev uses a file DB by default. For a serverless deploy point this at Turso.
# LIBSQL_URL=libsql://your-db.turso.io
# LIBSQL_AUTH_TOKEN=

# Gate for the demo deployment. Any non-empty value enables the login gate.
CLEARLINE_PASSWORD=
